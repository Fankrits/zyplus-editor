# Copy to .env and fill in. `openssl rand -base64 32` generates a secret.
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgres://zyplus:zyplus@localhost:5432/zyplus
PORT=3000

# Transactional mail (verification and password-reset codes). Get a key at
# resend.com/api-keys. Without one, sign-up and reset fail loudly rather than
# leaving the user waiting for a code that was never sent.
RESEND_API_KEY=re_replace_me
# Must be an address on a domain verified in Resend, with its SPF and DKIM
# records published. The default sandbox sender only delivers to the address
# that owns the Resend account, which is enough for development only.
MAIL_FROM=Zyplus <onboarding@resend.dev>
