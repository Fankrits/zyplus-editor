{
  "name": "zyplus-editor",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "bun test",
    "build:extensions": "bun scripts/build-extensions.ts",
    "check": "bun test && tsc && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets && cargo test --manifest-path src-tauri/Cargo.toml",
    "check:release": "bun run check && bun run tauri build --no-bundle",
    "db:up": "podman pull docker.io/library/postgres:17-alpine && podman pull docker.io/library/adminer:5 && podman compose up -d",
    "db:down": "podman compose down",
    "db:psql": "podman exec -it zyplus-editor-db-1 psql -U zyplus -d zyplus",
    "db:reset": "podman compose down -v && bun run db:up && sleep 5 && bun run server:migrate",
    "server": "cd server && bun run dev",
    "server:migrate": "cd server && bun run migrate"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@milkdown/crepe": "^7.22.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.4",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@uiw/react-codemirror": "^4.25.11",
    "better-auth": "^1.7.3",
    "katex": "^0.18.7",
    "marked": "^18.0.12",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
