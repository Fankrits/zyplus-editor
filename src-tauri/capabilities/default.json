{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. opener:default stays whole: the plugin's injected script opens clicked http(s), mailto and tel links through open-url.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:allow-join",
    "core:path:allow-dirname",
    "core:path:allow-resolve-directory",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "opener:default",
    "dialog:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    {
      "identifier": "fs:scope",
      "allow": [
        "**"
      ]
    }
  ]
}
